## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# NuGet packages
*.nupkg
.nuget/
nuget.exe

# MAUI specific
*.ds_store
*.appx
*.appxbundle
*.msix
*.msixbundle
*.pdb
*.idb

# Database files
*.db
*.mdf
*.ldf

# Don't ignore .db files in DataDirectory (if needed)
!**/DataDirectory/*.db

# Backup files
*.bak
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rider IDE
.idea/
*.sln.iml

# VS Code
.vscode/
.vs/