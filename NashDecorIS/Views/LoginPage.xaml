<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NashDecorIS.Views.LoginPage"
             Title="Авторизация"
             BackgroundColor="{AppThemeBinding Light=White, Dark=Black}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <!-- Заголовок -->
            <Label Text="Информационная система Наш Декор"
                   FontSize="24"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#512BD4, Dark=White}"
                   Margin="0,0,0,30"/>

            <!-- Поле логина -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Логин:" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Entry Placeholder="Введите ваш логин" 
                           Text="{Binding Username}"
                           Keyboard="Text"
                           ClearButtonVisibility="WhileEditing"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Поле пароля -->
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Пароль:" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <Entry Placeholder="Введите ваш пароль" 
                           Text="{Binding Password}"
                           IsPassword="True"
                           ClearButtonVisibility="WhileEditing"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Кнопка входа -->
            <Button Text="Войти" 
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    Margin="0,20,0,0"/>

            <!-- Сообщение об ошибке -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding HasError}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   Margin="0,10,0,0"/>

            <!-- Индикатор загрузки -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="#512BD4"
                              HorizontalOptions="Center"
                              Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>